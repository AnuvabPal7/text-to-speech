                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello! Welcome to our Java Spring Boot Text to Speech application.\",\n  \"language\": \"en-US\",\n  \"voice\": \"Joanna\",\n  \"speed\": 1.0,\n  \"pitch\": 1.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            }
          },
          "response": []
