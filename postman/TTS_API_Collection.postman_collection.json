    {
      "name": "4. History & Audio Files",
      "item": [
        {
          "name": "Get Speech History (GET /api/history)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Stream / Download Audio File (GET /api/audio/:filename)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audio/demo-initial.wav",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audio", "demo-initial.wav"]
            }
          },
          "response": []
        },
        {
          "name": "Delete History Record by ID (DELETE /api/history/:id)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Clear All History Records (DELETE /api/history)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"]
            }
          },
          "response": []
        }
