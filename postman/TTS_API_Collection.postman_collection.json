{
  "info": {
    "_postman_id": "8f657a84-7a32-4115-b771-96894c25fca1",
    "name": "Text-to-Speech (TTS) REST API Collection",
    "description": "Comprehensive Postman test collection for the Java Spring Boot Text-to-Speech application, covering health checks, voice querying, speech generation across multiple languages, error testing, and audio download.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Info",
      "item": [
        {
          "name": "Health Check (GET /api/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Voices",
      "item": [
        {
          "name": "Get All Voices (GET /api/voices)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/voices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voices"]
            }
          },
          "response": []
        },
        {
          "name": "Get Voices Filtered by Language (English)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/voices?language=en-US",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voices"],
              "query": [
                {
                  "key": "language",
                  "value": "en-US"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Voices Filtered by Language (Hindi)",
          "request": {
